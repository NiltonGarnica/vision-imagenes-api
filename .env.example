# Copia este archivo como .env y ajusta solo lo que necesites.

# Ruta a tesseract.exe si no está en el PATH (la ruta típica se detecta sola).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Carpeta con los *.traineddata si no usas la de la instalación (por ejemplo .\tessdata).
# TESSDATA_DIR=C:\Users\TU_USUARIO\vision-imagenes-api\tessdata

# Idiomas del OCR y modo de segmentación (11 = texto disperso; 6 = un bloque de texto).
TESSERACT_IDIOMA=spa+eng
TESSERACT_PSM=11

# Pesos de YOLO (se descargan solos la primera vez).
YOLO_MODELO=modelos/yolo11n.pt
# cpu por defecto. Para GPU: 0 (o cuda:0), con PyTorch compilado con CUDA.
YOLO_DISPOSITIVO=cpu
YOLO_CONFIANZA_MINIMA=0.25
